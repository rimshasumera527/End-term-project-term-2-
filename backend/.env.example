# TutorSlot backend configuration
PORT=5102
# MongoDB connection string (Atlas or local). Leave empty and set USE_MEMORY_DB=1 for zero-config demo mode.
MONGODB_URI=
# Set to 1 to run an in-memory MongoDB with auto-seeded demo data
USE_MEMORY_DB=
# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5302
